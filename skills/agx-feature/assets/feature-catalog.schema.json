{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenix.invalid/skills/agx-feature/assets/feature-catalog.schema.json",
  "title": "Agenix feature catalog",
  "type": "object",
  "properties": {
    "schema-version": {
      "description": "Version of the record format; use 1.",
      "const": 1
    },
    "kind": {
      "description": "Record kind identifying the document.",
      "const": "catalog"
    },
    "features": {
      "description": "Ordered index of feature IDs and record paths.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Stable identifier within the owning scope.",
            "type": "string",
            "pattern": "^FEAT-(?=[0-9]*[1-9])[0-9]{3,}$"
          },
          "path": {
            "description": "Project-relative path to the referenced record.",
            "type": "string",
            "pattern": "^docs/features/FEAT-(?=[0-9]*[1-9])[0-9]{3,}/feature\\.agenix\\.json$"
          }
        },
        "required": ["id", "path"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema-version", "kind", "features"],
  "additionalProperties": false
}
