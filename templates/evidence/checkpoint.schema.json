{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenix.invalid/templates/evidence/checkpoint.schema.json",
  "title": "Agenix checkpoint",
  "description": "Embed in the owning Git record. Include only entries applicable to the current step. Verify external facts, Git objects, stage requirements and human approval through the workflow.",
  "type": "object",
  "properties": {
    "checkpoint-id": {
      "description": "Stable checkpoint identifier within its owning record.",
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "description": "Workflow phase associated with the checkpoint.",
      "type": "string",
      "minLength": 1
    },
    "step": {
      "description": "Workflow step associated with the checkpoint.",
      "type": "string",
      "minLength": 1
    },
    "recorded-at": {
      "description": "UTC timestamp when the checkpoint was recorded.",
      "$ref": "#/$defs/utcTime"
    },
    "outcome": {
      "description": "Bounded outcome of the work item or recorded step.",
      "type": "string",
      "minLength": 1
    },
    "references": {
      "description": "References to the applicable authoritative artifacts or evidence.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRef"
      },
      "uniqueItems": true
    },
    "item-id": {
      "description": "Agenix identifier of the work item.",
      "$ref": "#/$defs/itemID"
    },
    "next-action": {
      "description": "Next action when work remains.",
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "description": "Reviewed Git candidate and applicable approved definitions.",
      "type": "object",
      "properties": {
        "base-commit": {
          "description": "Intended parent commit of the candidate.",
          "$ref": "#/$defs/gitOID"
        },
        "tree": {
          "description": "Git tree identifying the reviewed or checked candidate.",
          "$ref": "#/$defs/gitOID"
        },
        "target-base-commit": {
          "description": "Target base commit when review depends on it.",
          "$ref": "#/$defs/gitOID"
        },
        "approved-definitions": {
          "description": "Exact approved remote work-item definitions for reconciliation.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/approvedDefinition"
          },
          "minItems": 1
        },
        "baseline-commit": {
          "description": "Git baseline associated with the approved definitions.",
          "$ref": "#/$defs/gitOID"
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["base-commit", "tree"]
        },
        {
          "required": ["approved-definitions", "baseline-commit"]
        }
      ],
      "dependentRequired": {
        "base-commit": ["tree"],
        "tree": ["base-commit"],
        "target-base-commit": ["base-commit"],
        "approved-definitions": ["baseline-commit"],
        "baseline-commit": ["approved-definitions"]
      }
    },
    "decision": {
      "description": "Recorded human decision and its scope.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind of human decision, such as artifact approval, merge or override.",
          "type": "string",
          "enum": [
            "artifact",
            "review",
            "feature-acceptance",
            "merge",
            "exposure",
            "manual-confirmation",
            "cancellation",
            "override"
          ]
        },
        "result": {
          "description": "Actual result of the decision or check.",
          "type": "string",
          "enum": ["approved", "changes-requested", "passed", "failed"]
        },
        "actor": {
          "description": "Identity of the person making the decision.",
          "type": "string",
          "minLength": 1
        },
        "at": {
          "description": "UTC time of the decision or check.",
          "$ref": "#/$defs/utcTime"
        },
        "confirmation": {
          "description": "Actual human confirmation for the decision.",
          "type": "string",
          "minLength": 1
        },
        "authorized-actions": {
          "description": "Actions and targets explicitly authorized by the decision.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "description": "Action being authorized or recorded.",
                "type": "string",
                "minLength": 1
              },
              "target": {
                "description": "Artifact, environment or resource targeted by the containing record.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["action", "target"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "pr": {
          "description": "Reference to the relevant pull request.",
          "$ref": "#/$defs/prRef"
        },
        "head-commit": {
          "description": "Approved or published pull request head commit.",
          "$ref": "#/$defs/gitOID"
        },
        "operation-id": {
          "description": "Stable ID of the approved operation or command.",
          "type": "string",
          "minLength": 1
        },
        "target": {
          "description": "Artifact, environment or resource targeted by the containing record.",
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "description": "Immutable revision associated with the reference or evidence.",
          "$ref": "#/$defs/gitOID"
        },
        "artifact-ref": {
          "description": "Reference to the artifact covered by the decision.",
          "$ref": "#/$defs/evidenceRef"
        },
        "acceptance-ids": {
          "description": "Acceptance IDs covered by this reference or decision.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "check-ids": {
          "description": "IDs of applicable checks.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["kind", "result", "actor", "at", "confirmation"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["merge"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["pr", "head-commit"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["exposure"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["operation-id", "target"],
            "oneOf": [
              {
                "required": ["revision"]
              },
              {
                "required": ["artifact-ref"]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["manual-confirmation"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "anyOf": [
              {
                "required": ["acceptance-ids"]
              },
              {
                "required": ["check-ids"]
              }
            ]
          }
        }
      ]
    },
    "verification": {
      "description": "Applicable verification plan or actual check receipts.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationReceipt"
      },
      "minItems": 1
    },
    "publication": {
      "description": "Actual Git, pull request and tracker publication results.",
      "type": "object",
      "properties": {
        "head-commit": {
          "description": "Approved or published pull request head commit.",
          "$ref": "#/$defs/gitOID"
        },
        "pr": {
          "description": "Reference to the relevant pull request.",
          "$ref": "#/$defs/prRef"
        },
        "native-mappings": {
          "description": "Verified work-item and native tracker mappings.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativeMapping"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "merge-commit": {
          "description": "Verified merge commit.",
          "$ref": "#/$defs/gitOID"
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["head-commit"]
        },
        {
          "required": ["pr"]
        },
        {
          "required": ["native-mappings"]
        },
        {
          "required": ["merge-commit"]
        }
      ],
      "dependentRequired": {
        "merge-commit": ["pr", "head-commit"]
      }
    },
    "disposition": {
      "description": "Cancellation, override or permission disposition as applicable.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "item-id": {
              "description": "Agenix identifier of the work item.",
              "$ref": "#/$defs/itemID"
            },
            "reason": {
              "description": "Reason for the recorded disposition.",
              "type": "string",
              "minLength": 1
            },
            "replacement-refs": {
              "description": "References to approved replacement items.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifactRef"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": ["item-id", "reason"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "item-id": {
              "description": "Agenix identifier of the work item.",
              "$ref": "#/$defs/itemID"
            },
            "reason": {
              "description": "Reason for the recorded disposition.",
              "type": "string",
              "minLength": 1
            },
            "action": {
              "description": "Action being authorized or recorded.",
              "type": "string",
              "enum": ["allow-work", "accept-incomplete"]
            },
            "revision": {
              "description": "Immutable revision associated with the reference or evidence.",
              "$ref": "#/$defs/gitOID"
            },
            "waived-conditions": {
              "description": "Conditions waived by the approved override.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "permitted-work": {
              "description": "Work permitted by the approved override.",
              "type": "string",
              "minLength": 1
            },
            "consumer-scope": {
              "description": "Consumers affected by the accepted incomplete outcome.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "item-id",
            "reason",
            "action",
            "revision",
            "waived-conditions",
            "permitted-work",
            "consumer-scope"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "checkpoint-id",
    "phase",
    "step",
    "recorded-at",
    "outcome",
    "references"
  ],
  "additionalProperties": false,
  "$defs": {
    "featureID": {
      "type": "string",
      "pattern": "^FEAT-(?=[0-9]*[1-9])[0-9]{3,}$"
    },
    "ticketID": {
      "type": "string",
      "pattern": "^FEAT-(?=[0-9]*[1-9])[0-9]{3,}-T(?=[0-9]*[1-9])[0-9]{2,}$"
    },
    "taskID": {
      "type": "string",
      "pattern": "^FEAT-(?=[0-9]*[1-9])[0-9]{3,}-T(?=[0-9]*[1-9])[0-9]{2,}\\.[1-9][0-9]*$"
    },
    "itemID": {
      "oneOf": [
        {
          "$ref": "#/$defs/featureID"
        },
        {
          "$ref": "#/$defs/ticketID"
        },
        {
          "$ref": "#/$defs/taskID"
        }
      ]
    },
    "gitOID": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "utcTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "BLOCKED",
        "IN-PROGRESS",
        "IN-REVIEW",
        "DONE",
        "CANCELLED"
      ]
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:#\\r\\n]+$"
    },
    "artifactRef": {
      "type": "object",
      "properties": {
        "target": {
          "description": "Artifact, environment or resource targeted by the containing record.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://[^/\\s?#]+(?:[/?#][^\\s]*)?$"
            },
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:#\\r\\n]+(?:#[^\\r\\n]+)?$"
            }
          ]
        },
        "revision": {
          "description": "Immutable revision associated with the reference or evidence.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["target"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "not": {
                  "pattern": "^https://"
                }
              }
            },
            "required": ["target", "revision"]
          },
          "then": {
            "properties": {
              "revision": {
                "$ref": "#/$defs/gitOID"
              }
            }
          }
        }
      ]
    },
    "pinnedArtifactRef": {
      "type": "object",
      "properties": {
        "target": {
          "description": "Artifact, environment or resource targeted by the containing record.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://[^/\\s?#]+(?:[/?#][^\\s]*)?$"
            },
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:#\\r\\n]+(?:#[^\\r\\n]+)?$"
            }
          ]
        },
        "revision": {
          "description": "Immutable revision associated with the reference or evidence.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["target", "revision"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "not": {
                  "pattern": "^https://"
                }
              }
            },
            "required": ["target", "revision"]
          },
          "then": {
            "properties": {
              "revision": {
                "$ref": "#/$defs/gitOID"
              }
            }
          }
        }
      ]
    },
    "ticketArtifactRef": {
      "type": "object",
      "properties": {
        "target": {
          "description": "Artifact, environment or resource targeted by the containing record.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://[^/\\s?#]+(?:[/?#][^\\s]*)?$"
            },
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:#\\r\\n]+(?:#[^\\r\\n]+)?$"
            }
          ]
        },
        "revision": {
          "description": "Immutable revision associated with the reference or evidence.",
          "type": "string",
          "minLength": 1
        },
        "acceptance-ids": {
          "description": "Acceptance IDs covered by this reference or decision.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["target", "revision"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "not": {
                  "pattern": "^https://"
                }
              }
            },
            "required": ["target", "revision"]
          },
          "then": {
            "properties": {
              "revision": {
                "$ref": "#/$defs/gitOID"
              }
            }
          }
        }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "target": {
          "description": "Artifact, environment or resource targeted by the containing record.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://[^/\\s?#]+(?:[/?#][^\\s]*)?$"
            },
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:#\\r\\n]+(?:#[^\\r\\n]+)?$"
            }
          ]
        },
        "revision": {
          "description": "Immutable revision associated with the reference or evidence.",
          "$ref": "#/$defs/gitOID"
        },
        "checkpoint-id": {
          "description": "Stable checkpoint identifier within its owning record.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["target"],
      "additionalProperties": false
    },
    "prRef": {
      "type": "object",
      "properties": {
        "number": {
          "description": "Native GitHub issue or pull request number.",
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "description": "HTTPS URL of the native record.",
          "type": "string",
          "pattern": "^https://[^/\\s?#]+(?:[/?#][^\\s]*)?$"
        }
      },
      "required": ["number", "url"],
      "additionalProperties": false
    },
    "nativeRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "number": {
              "description": "Native GitHub issue or pull request number.",
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "description": "HTTPS URL of the native record.",
              "type": "string",
              "pattern": "^https://[^/\\s?#]+(?:[/?#][^\\s]*)?$"
            }
          },
          "required": ["number", "url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "description": "Jira issue key.",
              "type": "string",
              "minLength": 1
            },
            "native-id": {
              "description": "Native Jira issue ID.",
              "type": "string",
              "minLength": 1
            },
            "url": {
              "description": "HTTPS URL of the native record.",
              "type": "string",
              "pattern": "^https://[^/\\s?#]+(?:[/?#][^\\s]*)?$"
            }
          },
          "required": ["key", "native-id", "url"],
          "additionalProperties": false
        }
      ]
    },
    "nativeMapping": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier within the owning scope.",
          "oneOf": [
            {
              "$ref": "#/$defs/ticketID"
            },
            {
              "$ref": "#/$defs/taskID"
            }
          ]
        },
        "native-ref": {
          "description": "Verified native tracker reference.",
          "$ref": "#/$defs/nativeRef"
        }
      },
      "required": ["id", "native-ref"],
      "additionalProperties": false
    },
    "acceptanceCriterion": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier within the owning scope.",
          "type": "string",
          "minLength": 1
        },
        "criterion": {
          "description": "Observable acceptance condition.",
          "type": "string",
          "minLength": 1
        },
        "covers": {
          "description": "Parent ticket acceptance IDs covered by this criterion.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["id", "criterion", "covers"],
      "additionalProperties": false
    },
    "taskVerification": {
      "type": "object",
      "properties": {
        "method": {
          "description": "Approved verification method for the task.",
          "type": "string",
          "enum": ["test-first", "test-after", "manual"]
        },
        "checks": {
          "description": "IDs of approved checks applicable to the task.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exception-reason": {
          "description": "Approved reason for a non-default verification method.",
          "type": "string",
          "minLength": 1
        },
        "manual-procedure": {
          "description": "Procedure for the manual check.",
          "type": "string",
          "minLength": 1
        },
        "expected-result": {
          "description": "Expected result of the manual check.",
          "type": "string",
          "minLength": 1
        },
        "responsible-verifier": {
          "description": "Human responsible for the manual judgment.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["method", "checks"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "type": "string",
                "enum": ["test-first", "test-after"]
              }
            },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "checks": {
                "minItems": 1
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["manual-procedure"]
                },
                {
                  "required": ["expected-result"]
                },
                {
                  "required": ["responsible-verifier"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "type": "string",
                "enum": ["test-first"]
              }
            },
            "required": ["method"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["exception-reason"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "type": "string",
                "enum": ["test-after", "manual"]
              }
            },
            "required": ["method"]
          },
          "then": {
            "required": ["exception-reason"]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "type": "string",
                "enum": ["manual"]
              }
            },
            "required": ["method"]
          },
          "then": {
            "required": [
              "manual-procedure",
              "expected-result",
              "responsible-verifier"
            ]
          }
        }
      ]
    },
    "verificationReceipt": {
      "type": "object",
      "properties": {
        "check-id": {
          "description": "Stable ID of a check in the approved environment.",
          "type": "string",
          "minLength": 1
        },
        "item-id": {
          "description": "Agenix identifier of the work item.",
          "$ref": "#/$defs/itemID"
        },
        "acceptance-ids": {
          "description": "Acceptance IDs covered by this reference or decision.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "result": {
          "description": "Actual result of the decision or check.",
          "type": "string",
          "enum": ["passed", "failed", "pending", "skipped", "unavailable"]
        },
        "at": {
          "description": "UTC time of the decision or check.",
          "$ref": "#/$defs/utcTime"
        },
        "environment": {
          "description": "Environment in which the operation or check applies.",
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "description": "Immutable revision associated with the reference or evidence.",
          "$ref": "#/$defs/gitOID"
        },
        "tree": {
          "description": "Git tree identifying the reviewed or checked candidate.",
          "$ref": "#/$defs/gitOID"
        },
        "check-level": {
          "description": "Level or type of the check.",
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "description": "Execution mode for the operation or check.",
          "type": "string",
          "minLength": 1
        },
        "evidence-ref": {
          "description": "Reference to durable supporting evidence.",
          "$ref": "#/$defs/evidenceRef"
        },
        "detail": {
          "description": "Additional context for the actual result.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["check-id", "result", "at", "environment"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["revision"]
        },
        {
          "required": ["tree"]
        }
      ],
      "dependentRequired": {
        "item-id": ["acceptance-ids"],
        "acceptance-ids": ["item-id"]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "type": "string",
                "enum": ["passed", "failed"]
              }
            },
            "required": ["result"]
          },
          "then": {
            "required": ["evidence-ref"]
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "type": "string",
                "enum": ["pending", "skipped", "unavailable"]
              }
            },
            "required": ["result"]
          },
          "then": {
            "required": ["detail"]
          }
        }
      ]
    },
    "approvedTicket": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier within the owning scope.",
          "$ref": "#/$defs/ticketID"
        },
        "title": {
          "description": "Concise title of the work item.",
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "description": "Bounded outcome of the work item or recorded step.",
          "type": "string",
          "minLength": 1
        },
        "feature-id": {
          "description": "ID of the owning feature.",
          "$ref": "#/$defs/featureID"
        },
        "feature-ref": {
          "description": "Pinned reference to the owning feature record.",
          "$ref": "#/$defs/pinnedArtifactRef"
        },
        "type": {
          "description": "Approved work type.",
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "description": "Approved lowercase scope.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[^A-Z]+$"
        },
        "priority": {
          "description": "Approved priority label.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[^A-Z]+$"
        },
        "owner": {
          "description": "Approved owner or responsibility.",
          "type": "string",
          "minLength": 1
        },
        "depends-on": {
          "description": "IDs of hard prerequisites within the owning scope; use an empty array when none apply.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ticketID"
          },
          "uniqueItems": true
        },
        "references": {
          "description": "References to the applicable authoritative artifacts or evidence.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ticketArtifactRef"
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "required": ["acceptance-ids"]
          }
        },
        "origin-ref": {
          "description": "Source of additive work, such as a finding or amendment.",
          "anyOf": [
            {
              "$ref": "#/$defs/artifactRef"
            },
            {
              "$ref": "#/$defs/evidenceRef"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "outcome",
        "feature-id",
        "feature-ref",
        "type",
        "scope",
        "priority",
        "owner",
        "depends-on",
        "references"
      ],
      "additionalProperties": false
    },
    "approvedTask": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier within the owning scope.",
          "$ref": "#/$defs/taskID"
        },
        "title": {
          "description": "Concise title of the work item.",
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "description": "Bounded outcome of the work item or recorded step.",
          "type": "string",
          "minLength": 1
        },
        "depends-on": {
          "description": "IDs of hard prerequisites within the owning scope; use an empty array when none apply.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskID"
          },
          "uniqueItems": true
        },
        "acceptance": {
          "description": "Observable task acceptance criteria and their parent coverage.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptanceCriterion"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "verification": {
          "description": "Applicable verification plan or actual check receipts.",
          "$ref": "#/$defs/taskVerification"
        },
        "references": {
          "description": "References to the applicable authoritative artifacts or evidence.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/pinnedArtifactRef"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ticket-id": {
          "description": "ID of the owning ticket.",
          "$ref": "#/$defs/ticketID"
        },
        "origin-ref": {
          "description": "Source of additive work, such as a finding or amendment.",
          "anyOf": [
            {
              "$ref": "#/$defs/artifactRef"
            },
            {
              "$ref": "#/$defs/evidenceRef"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "outcome",
        "depends-on",
        "acceptance",
        "verification",
        "ticket-id"
      ],
      "additionalProperties": false
    },
    "approvedDefinition": {
      "oneOf": [
        {
          "$ref": "#/$defs/approvedTicket"
        },
        {
          "$ref": "#/$defs/approvedTask"
        }
      ]
    }
  }
}
