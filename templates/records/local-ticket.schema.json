{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenix.invalid/templates/records/local-ticket.schema.json",
  "title": "Agenix local ticket record",
  "description": "Use for a local ticket JSON file. Include tasks after task-plan approval. The containing ticket supplies parent identity. Check parent IDs, dependencies, coverage, the approved snapshot and child completion through the workflow.",
  "type": "object",
  "properties": {
    "schema-version": {
      "description": "Version of the record format; use 1.",
      "const": 1
    },
    "kind": {
      "description": "Record kind identifying the document.",
      "const": "ticket"
    },
    "id": {
      "description": "Stable identifier within the owning scope.",
      "$ref": "../evidence/checkpoint.schema.json#/$defs/ticketID"
    },
    "title": {
      "description": "Concise title of the work item.",
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "description": "Bounded outcome of the work item or recorded step.",
      "type": "string",
      "minLength": 1
    },
    "feature-id": {
      "description": "ID of the owning feature.",
      "$ref": "../evidence/checkpoint.schema.json#/$defs/featureID"
    },
    "feature-ref": {
      "description": "Pinned reference to the owning feature record.",
      "$ref": "../evidence/checkpoint.schema.json#/$defs/pinnedArtifactRef"
    },
    "type": {
      "description": "Approved work type.",
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "description": "Approved lowercase scope.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^A-Z]+$"
    },
    "priority": {
      "description": "Approved priority label.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^A-Z]+$"
    },
    "owner": {
      "description": "Approved owner or responsibility.",
      "type": "string",
      "minLength": 1
    },
    "depends-on": {
      "description": "IDs of hard prerequisites within the owning scope; use an empty array when none apply.",
      "type": "array",
      "items": {
        "$ref": "../evidence/checkpoint.schema.json#/$defs/ticketID"
      },
      "uniqueItems": true
    },
    "references": {
      "description": "Pinned feature scope and contract references, including selected acceptance IDs.",
      "type": "array",
      "items": {
        "$ref": "../evidence/checkpoint.schema.json#/$defs/ticketArtifactRef"
      },
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "required": ["acceptance-ids"]
      }
    },
    "status": {
      "description": "Declared lifecycle status; verify readiness and completion separately.",
      "$ref": "../evidence/checkpoint.schema.json#/$defs/status"
    },
    "approval-ref": {
      "description": "Separately stored approval evidence when needed.",
      "$ref": "../evidence/checkpoint.schema.json#/$defs/evidenceRef"
    },
    "checkpoint-refs": {
      "description": "References to separately stored checkpoints.",
      "type": "array",
      "items": {
        "$ref": "../evidence/checkpoint.schema.json#/$defs/evidenceRef"
      }
    },
    "checkpoints": {
      "description": "Durable records of decisions, checks and publication evidence.",
      "type": "array",
      "items": {
        "$ref": "../evidence/checkpoint.schema.json"
      }
    },
    "origin-ref": {
      "description": "Source of additive work, such as a finding or amendment.",
      "anyOf": [
        {
          "$ref": "../evidence/checkpoint.schema.json#/$defs/artifactRef"
        },
        {
          "$ref": "../evidence/checkpoint.schema.json#/$defs/evidenceRef"
        }
      ]
    },
    "tasks": {
      "description": "Approved task definitions, added after task planning.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema-version",
    "kind",
    "id",
    "title",
    "outcome",
    "feature-id",
    "feature-ref",
    "type",
    "scope",
    "priority",
    "owner",
    "depends-on",
    "references",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier within the owning scope.",
          "$ref": "../evidence/checkpoint.schema.json#/$defs/taskID"
        },
        "title": {
          "description": "Concise title of the work item.",
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "description": "Bounded outcome of the work item or recorded step.",
          "type": "string",
          "minLength": 1
        },
        "depends-on": {
          "description": "Sibling task IDs. Tasks that use manual verification cannot be prerequisites.",
          "type": "array",
          "items": {
            "$ref": "../evidence/checkpoint.schema.json#/$defs/taskID"
          },
          "uniqueItems": true
        },
        "acceptance": {
          "description": "Observable task acceptance criteria and their parent coverage.",
          "type": "array",
          "items": {
            "$ref": "../evidence/checkpoint.schema.json#/$defs/acceptanceCriterion"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "verification": {
          "description": "Applicable verification plan or actual check receipts.",
          "$ref": "../evidence/checkpoint.schema.json#/$defs/taskVerification"
        },
        "references": {
          "description": "Pinned feature scope and contract references, including selected acceptance IDs.",
          "type": "array",
          "items": {
            "$ref": "../evidence/checkpoint.schema.json#/$defs/pinnedArtifactRef"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "description": "Declared lifecycle status; verify readiness and completion separately.",
          "$ref": "../evidence/checkpoint.schema.json#/$defs/status"
        },
        "approval-ref": {
          "description": "Separately stored approval evidence when needed.",
          "$ref": "../evidence/checkpoint.schema.json#/$defs/evidenceRef"
        },
        "checkpoint-refs": {
          "description": "References to separately stored checkpoints.",
          "type": "array",
          "items": {
            "$ref": "../evidence/checkpoint.schema.json#/$defs/evidenceRef"
          }
        },
        "checkpoints": {
          "description": "Durable records of decisions, checks and publication evidence.",
          "type": "array",
          "items": {
            "$ref": "../evidence/checkpoint.schema.json"
          }
        },
        "origin-ref": {
          "description": "Source of additive work, such as a finding or amendment.",
          "anyOf": [
            {
              "$ref": "../evidence/checkpoint.schema.json#/$defs/artifactRef"
            },
            {
              "$ref": "../evidence/checkpoint.schema.json#/$defs/evidenceRef"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "outcome",
        "depends-on",
        "acceptance",
        "verification",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
